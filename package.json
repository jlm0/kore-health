{
  "name": "kore-health",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --cwd apps/mobile start",
    "ios": "bun run --cwd apps/mobile ios",
