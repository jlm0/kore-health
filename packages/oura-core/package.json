{
  "name": "@kore/oura-core",
  "version": "0.1.0",
  "description": "Oura ring BLE protocol native module (Craby)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "codegen": "crabygen codegen",
    "build": "crabygen build && tsdown",
    "clean": "crabygen clean"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "author": "Kore <kore@example.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kore/kore-health/issues"
  },
  "homepage": "https://github.com/kore/kore-health#readme",
  "dependencies": {
    "craby-modules": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@react-native-community/cli-types": "^20.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "crabygen": "^0.1.0-rc.7",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "tsdown": "^0.15.10",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
}
